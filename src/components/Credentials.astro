---
import type { Award, Certification } from "../data/profile";

interface Props {
  awards: Award[];
  certifications: Certification[];
}

const { awards, certifications } = Astro.props;
const heading = "Credentials & awards";
const groups = [
  {
    id: "competition-awards",
    label: "Competition awards",
    featured: true,
    entries: awards,
  },
  {
    id: "certifications",
    label: "Certifications",
    featured: false,
    entries: certifications.map((entry) => ({ ...entry, title: entry.name })),
  },
].filter((group) => group.entries.length > 0);
---

{groups.length > 0 && (
  <section class="sec credentials" id="credentials" aria-labelledby="credentials-heading">
    <header class="credentials-head">
      <h2 id="credentials-heading">
        {heading.split(" ").map((word, index) => (
          <>{index > 0 && " "}<span data-credential-word>{word}</span></>
        ))}
      </h2>
      <nav class="credentials-jump" aria-label="Credential categories">
        {groups.map(({ id, label }) => (
          <a href={`#${id}`}>{label} <span aria-hidden="true">↓</span></a>
        ))}
      </nav>
    </header>

    {groups.map(({ id, label, featured, entries }) => (
      <section class="credential-group" id={id} aria-labelledby={`${id}-heading`}>
        <h3 id={`${id}-heading`}>{label}</h3>
        <ul class="credential-grid">
          {entries.map((entry) => {
            const fileId = entry.driveFileId?.trim();
            const file = fileId ? encodeURIComponent(fileId) : "";
            return (
              <li class:list={["credential-card", { featured }]}>
                <article>
                  <div class="credential-content">
                    {file && (
                      <div class="credential-preview" data-award-preview={featured ? "" : undefined}>
                        {featured && (
                          <>
                            <span class="document-layer" data-document-layer aria-hidden="true"></span>
                            <span class="document-layer" data-document-layer aria-hidden="true"></span>
                          </>
                        )}
                        <div class="credential-paper" data-document-layer>
                          <img
                            src={`https://drive.google.com/thumbnail?id=${file}&sz=${featured ? "w800" : "w320"}`}
                            width={800}
                            height={566}
                            alt=""
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                      </div>
                    )}
                    <div class="credential-info">
                      {entry.detail && <p class="credential-detail">{entry.detail}</p>}
                      <h4>{entry.title}</h4>
                      <p class="credential-meta">
                        <span>{entry.issuer}</span>
                        <span aria-hidden="true">·</span>
                        <span>{entry.date}</span>
                      </p>
                      {entry.validThrough && (
                        <p class="credential-id">Valid through {entry.validThrough}</p>
                      )}
                      {entry.credentialId && <p class="credential-id">ID {entry.credentialId}</p>}
                    </div>
                  </div>
                  {file && (
                    <div class="credential-actions">
                      <a
                        class="credential-view"
                        href={`https://drive.google.com/file/d/${file}/view`}
                        target="_blank"
                        rel="noopener"
                        aria-label={`View ${entry.title} on Google Drive (opens in a new tab)`}
                      >View <span aria-hidden="true">↗</span></a>
                      <a
                        class="credential-download"
                        href={`https://drive.google.com/uc?export=download&id=${file}`}
                        target="_blank"
                        rel="noopener"
                        aria-label={`Download ${entry.title} from Google Drive`}
                      >Download <span aria-hidden="true">↓</span></a>
                    </div>
                  )}
                </article>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </section>
)}

<style>
  .credentials,
  .credential-group {
    scroll-margin-block-start: 90px;
  }

  .credentials-head {
    padding-block: clamp(48px, 8vw, 96px) clamp(46px, 7vw, 76px);
    border-block-start: 1px solid var(--line-strong);
    text-align: center;
    background: radial-gradient(ellipse at 50% 0%, var(--accent-faint), transparent 68%);
  }

  .credentials-head h2 {
    max-inline-size: 64rem;
    margin: 0 auto;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(2.7rem, 7vw, 5.2rem);
    font-weight: 400;
    line-height: 0.99;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .credentials-head h2 span { display: inline-block; }

  .credentials-jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 12px;
    margin-block-start: 22px;
  }

  .credentials-jump a,
  .credential-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-block-size: 44px;
    padding-inline: 14px;
    border-radius: 5px;
    font-size: 0.91rem;
    font-weight: 600;
    transition: background-color 180ms ease, border-color 180ms ease;
  }

  .credentials-jump a {
    border: 1px solid var(--line-strong);
    background: var(--panel);
    color: var(--ink);
  }

  .credentials-jump a:hover {
    border-color: var(--accent);
    background: var(--bg);
  }

  .credential-group + .credential-group {
    margin-block-start: clamp(42px, 6vw, 72px);
  }

  .credential-group h3 {
    margin: 0 0 16px;
    padding-block-start: 14px;
    border-block-start: 1px solid var(--line-strong);
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.5vw, 2.15rem);
    font-weight: 400;
    line-height: 1.13;
    letter-spacing: -0.02em;
  }

  .credential-grid {
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .credential-card {
    min-inline-size: 0;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--panel);
  }

  .credential-card:last-child:nth-child(odd) { grid-column: 1 / -1; }

  .credential-card article {
    display: flex;
    flex-direction: column;
    block-size: 100%;
  }

  .credential-content {
    display: flex;
    align-items: flex-start;
    gap: clamp(12px, 2vw, 22px);
    padding: clamp(14px, 2vw, 22px);
  }

  .featured .credential-content {
    display: block;
    padding: 0;
  }

  .credential-preview {
    position: relative;
    display: grid;
    place-items: center;
    flex: 0 0 clamp(66px, 11vw, 132px);
    aspect-ratio: 1.36;
    overflow: clip;
    border-radius: 4px;
    background: linear-gradient(135deg, var(--accent-faint), var(--bg-soft));
  }

  .featured .credential-preview {
    aspect-ratio: 1.85;
    max-block-size: 280px;
    border-radius: 7px 7px 0 0;
    border-block-end: 1px solid var(--line);
    background:
      radial-gradient(ellipse at 50% 20%, var(--panel), transparent 72%),
      linear-gradient(138deg, var(--accent-soft), var(--bg-soft));
  }

  .credential-paper,
  .document-layer {
    grid-area: 1 / 1;
    inline-size: 84%;
    aspect-ratio: 800 / 566;
    border-radius: 2px;
    background: #f1f2f4;
    box-shadow: 0 2px 8px rgb(12 20 30 / 0.16);
  }

  .featured .credential-paper,
  .featured .document-layer {
    inline-size: min(62%, 296px);
    box-shadow: 0 9px 25px rgb(12 20 30 / 0.16);
  }

  .document-layer:first-child { translate: -9px 4px; rotate: -6deg; }
  .document-layer:nth-child(2) { translate: 8px 5px; rotate: 5deg; }

  .credential-paper {
    position: relative;
    z-index: 1;
    overflow: clip;
    transition: scale 550ms var(--ease);
  }

  .credential-paper img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .credential-card:hover .credential-paper { scale: 1.045; }
  }

  .credential-info {
    min-inline-size: 0;
  }

  .featured .credential-info {
    padding: clamp(16px, 2.5vw, 26px) clamp(16px, 2.5vw, 26px) 18px;
  }

  .credential-info h4 {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2.2vw, 1.62rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.018em;
    text-wrap: pretty;
  }

  .featured h4 {
    font-size: clamp(1.5rem, 3vw, 2.16rem);
  }

  .credential-detail {
    margin: 0 0 7px;
    color: var(--accent);
    font-size: 0.83rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .credential-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 7px;
    margin: 7px 0 0;
    color: var(--body-strong);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .credential-id {
    margin: 5px 0 0;
    color: var(--body);
    font-family: var(--mono);
    font-size: 0.68rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .credential-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin: auto clamp(14px, 2vw, 22px) 0;
    padding-block: 10px 12px;
    border-block-start: 1px solid var(--line);
  }

  .featured .credential-actions { margin-inline: clamp(16px, 2.5vw, 26px); }

  .credential-actions .credential-view {
    background: var(--ink);
    color: var(--bg);
  }

  .credential-actions .credential-view:hover { background: var(--body-strong); }

  .credential-actions .credential-download {
    color: var(--ink);
  }

  .credential-download:hover { background: var(--chip-bg); }

  @media (max-width: 700px) {
    .credential-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const credentials = document.querySelector("#credentials");
  if (credentials) {
    gsap.registerPlugin(ScrollTrigger);
    gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from(credentials.querySelectorAll("[data-credential-word]"), {
        yPercent: 20,
        opacity: 0.75,
        stagger: 0.13,
        ease: "none",
        scrollTrigger: {
          trigger: credentials.querySelector(".credentials-head"),
          start: "top 96%",
          end: "top 62%",
          scrub: true,
        },
      });

      credentials.querySelectorAll("[data-award-preview]").forEach((preview) => {
        gsap.from(preview.querySelectorAll("[data-document-layer]"), {
          y: 24,
          scale: 0.94,
          stagger: 0.13,
          ease: "none",
          scrollTrigger: {
            trigger: preview,
            start: "top 96%",
            end: "center 60%",
            scrub: true,
          },
        });
      });
    });
  }
</script>
