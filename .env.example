# Public portfolio content is managed in src/data/content.json or through
# /admin/. The values below are deliberately kept OUT of that file and out of
# git: copy this file to .env for local builds, and set the same names as
# GitHub Actions secrets or variables for the deployed site
# (Settings -> Secrets and variables -> Actions).
#
# Note: these are injected into the generated HTML at build time, so they are
# still visible on the published page. This keeps them out of the repository,
# not off the public web.

# Contact address shown in the hero and the contact section.
CONTACT_EMAIL=

# Optional. Left blank, no phone number is rendered.
CONTACT_PHONE=

# CV Builder origin only — no path, no trailing slash.
# Example: https://cv-builder.example.com
RESUME_APP_URL=

# Share token of the published résumé. Combined with RESUME_APP_URL this
# produces the preview and PDF links. Without both, the résumé button falls
# back to a "connect your CV Builder" placeholder.
RESUME_TOKEN=
