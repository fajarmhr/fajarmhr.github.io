# ─────────────────────────────────────────────────────────────
#  Résumé / CV Builder connection (OPTIONAL)
#  Read at build time. Copy this file to .env for local development.
#  For the live site, add the SAME keys as GitHub repository Secrets:
#    Settings → Secrets and variables → Actions → New repository secret
#  Leave blank to show the "Connect your CV Builder" message.
# ─────────────────────────────────────────────────────────────
RESUME_APP_URL=
RESUME_TOKEN=
